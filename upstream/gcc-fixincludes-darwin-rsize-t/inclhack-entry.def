/*
 * Final fixincludes hack as it appears in the attached patch
 * (0001-fixincludes-Fix-rsize_t-with-Darwin-modules.patch),
 * inserted in fixincludes/inclhack.def between darwin_private_extern and
 * darwin_stdint_1, matching the neighboring darwin hacks' conventions
 * (mach "*-*-darwin*", c_fix = format, bypass for idempotency).
 *
 * Unlike the earlier draft (which blanked the whole condition to 0) and
 * unlike the production local fixinclude (fixed-header.h, which replaces
 * the header body), the upstream fix rewrites the guard to additionally
 * require __clang__, so the header's own plain-typedef branch is taken
 * under GCC while Clang branch selection remains unchanged.  The bypass
 * matches the corrected predicate, making the fix idempotent without
 * skipping a header merely because it mentions __clang__ elsewhere.
 */

/*
 * The SDK's <sys/_types/_rsize_t.h> gates its clang-modules branch on
 * __has_feature(modules), but GCC also reports that feature under
 * -fmodules.  The branch then relies on the clang-only stddef.h
 * __need_rsize_t protocol, which GCC's stddef.h does not implement, so
 * rsize_t is never defined and the C11 Annex K declarations in the SDK's
 * <string.h> fail to parse.  Require __clang__ so that GCC always takes
 * the plain typedef branch.
 */
fix = {
    hackname  = darwin_rsize_t_modules;
    mach      = "*-*-darwin*";
    files     = sys/_types/_rsize_t.h;
    bypass    = "defined\\(__clang__\\) && defined\\(__has_feature\\) && "
		"__has_feature\\(modules\\)";
    select    = "defined\\(__has_feature\\) && __has_feature\\(modules\\)";
    c_fix     = format;
    c_fix_arg = "defined(__clang__) && defined(__has_feature) && "
		"__has_feature(modules)";
    test_text = "#if defined(__has_feature) && __has_feature(modules)\n"
		"#define USE_CLANG_STDDEF 1\n"
		"#else\n"
		"#define USE_CLANG_STDDEF 0\n"
		"#endif";
};
