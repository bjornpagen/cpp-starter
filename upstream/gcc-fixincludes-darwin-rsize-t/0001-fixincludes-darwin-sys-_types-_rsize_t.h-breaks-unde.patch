diff --git a/fixincludes/inclhack.def b/fixincludes/inclhack.def
index 20a7e8ef9..018a92497 100644
--- a/fixincludes/inclhack.def
+++ b/fixincludes/inclhack.def
@@ -1602,6 +1602,31 @@ fix = {
 	      "unsigned long *address);\n";
 };
 
+/*
+ * The SDK's <sys/_types/_rsize_t.h> gates its clang-modules branch on
+ * __has_feature(modules), but GCC also reports that feature under
+ * -fmodules.  The branch then relies on the clang-only stddef.h
+ * __need_rsize_t protocol, which GCC's stddef.h does not implement, so
+ * rsize_t is never defined and the C11 Annex K declarations in the SDK's
+ * <string.h> fail to parse.  Require __clang__ so that GCC always takes
+ * the plain typedef branch.
+ */
+fix = {
+    hackname  = darwin_rsize_t_modules;
+    mach      = "*-*-darwin*";
+    files     = sys/_types/_rsize_t.h;
+    bypass    = "__clang__";
+    select    = "defined\\(__has_feature\\) && __has_feature\\(modules\\)";
+    c_fix     = format;
+    c_fix_arg = "defined(__clang__) && defined(__has_feature) && "
+		"__has_feature(modules)";
+    test_text = "#if defined(__has_feature) && __has_feature(modules)\n"
+		"#define USE_CLANG_STDDEF 1\n"
+		"#else\n"
+		"#define USE_CLANG_STDDEF 0\n"
+		"#endif";
+};
+
 /*
  * Darwin headers have a stdint.h that defines UINT8_C and UINT16_C to
  * unsigned constants.
diff --git a/fixincludes/tests/base/sys/_types/_rsize_t.h b/fixincludes/tests/base/sys/_types/_rsize_t.h
new file mode 100644
index 000000000..7ff637d9d
--- /dev/null
+++ b/fixincludes/tests/base/sys/_types/_rsize_t.h
@@ -0,0 +1,18 @@
+/*  DO NOT EDIT THIS FILE.
+
+    It has been auto-edited by fixincludes from:
+
+	"fixinc/tests/inc/sys/_types/_rsize_t.h"
+
+    This had to be done to correct non-standard usages in the
+    original, manufacturer supplied header file.  */
+
+
+
+#if defined( DARWIN_RSIZE_T_MODULES_CHECK )
+#if defined(__clang__) && defined(__has_feature) && __has_feature(modules)
+#define USE_CLANG_STDDEF 1
+#else
+#define USE_CLANG_STDDEF 0
+#endif
+#endif  /* DARWIN_RSIZE_T_MODULES_CHECK */
