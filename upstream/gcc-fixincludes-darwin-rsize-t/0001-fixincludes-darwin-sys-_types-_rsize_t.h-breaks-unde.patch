 /* * * * * * * * * * * * * * * * * * * * * * * * * *
  *
  *  Description of Darwin_Stdint_1 fix
@@ -10283,9 +10327,9 @@ static const char* apzX11_SprintfPatch[] = {
  *
  *  List of all fixes
  */
-#define REGEX_COUNT          291
+#define REGEX_COUNT          293
 #define MACH_LIST_SIZE_LIMIT 187
