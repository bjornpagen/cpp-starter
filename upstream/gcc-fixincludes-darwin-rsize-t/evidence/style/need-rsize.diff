 /* Any one of these symbols __need_* means that GNU libc
    wants us just to define one data type.  So don't define
    the symbols that indicate this file's entire job has been done.  */
 #if (!defined(__need_wchar_t) && !defined(__need_size_t)	\
      && !defined(__need_ptrdiff_t) && !defined(__need_NULL)	\
-     && !defined(__need_wint_t))
+     && !defined(__need_wint_t) && !defined(__need_rsize_t))
 #define _STDDEF_H
 #define _STDDEF_H_
 /* snaroff@next.com says the NeXT needs this.  */
@@ -252,6 +252,21 @@ typedef long ssize_t;
 #undef	__need_size_t
 #endif /* _STDDEF_H or __need_size_t.  */
 
+/* Restricted-size type from ISO C11 Annex K.  Define it only when a
+   system header explicitly requests it via __need_rsize_t.  A normal
+   inclusion of this header does not provide the type; many C libraries
+   do not implement Annex K.  RSIZE_MAX and the bounds-checked
+   functions remain the C library's responsibility.  */
+#if defined (__need_rsize_t)
+#ifndef _RSIZE_T	/* in case the OS headers have defined it.  */
+#define _RSIZE_T
+#ifndef __SIZE_TYPE__
+#define __SIZE_TYPE__ long unsigned int
+#endif
+typedef __SIZE_TYPE__ rsize_t;
+#endif /* _RSIZE_T */
+#undef __need_rsize_t
+#endif /* __need_rsize_t.  */
 
