{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "$env{HOME}/.gcc/current/bin/g++-16"
      }
    },
    {
      "name": "gcc-dev",
      "displayName": "GCC debug",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC optimized production build",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-asan-ubsan",
      "displayName": "GCC AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "gcc-tsan",
      "displayName": "GCC ThreadSanitizer",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "clang-lint",
      "displayName": "Clang lint graph (clang-tidy runs during build)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/opt/local/libexec/llvm-22/bin/clang++",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "/opt/local/libexec/llvm-22/bin/clang-scan-deps",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_CXX_STDLIB_MODULES_JSON": "/opt/local/libexec/llvm-22/lib/libc++/libc++.modules.json",
        "CMAKE_EXE_LINKER_FLAGS": "-L/opt/local/libexec/llvm-22/lib/libc++ -Wl,-rpath,/opt/local/libexec/llvm-22/lib/libc++",
        "CMAKE_CXX_CLANG_TIDY": "/opt/local/libexec/llvm-22/bin/clang-tidy;--experimental-custom-checks",
        "STARTER_LINT_GRAPH": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc-dev", "configurePreset": "gcc-dev" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "gcc-asan-ubsan", "configurePreset": "gcc-asan-ubsan" },
    { "name": "gcc-tsan", "configurePreset": "gcc-tsan" },
    { "name": "clang-lint", "configurePreset": "clang-lint" }
  ],
  "testPresets": [
    {
      "name": "gcc-dev",
      "configurePreset": "gcc-dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-asan-ubsan",
      "configurePreset": "gcc-asan-ubsan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gcc-tsan",
      "configurePreset": "gcc-tsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
